{
  "name": "trello-cli-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun run --filter '*' test",
    "dev": "bun run --filter '*' --parallel dev",
    "build": "bunx typescript@5.7.3 -b",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  }
}
