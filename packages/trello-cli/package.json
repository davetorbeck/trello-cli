{
  "name": "trello-cli",
  "version": "1.0.7",
  "description": "Access your Trello account using the CLI",
  "author": "Michael Heap <m@michaelheap.com>",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "trello": "./bin/run"
  },
  "homepage": "https://github.com/davetorbeck/trello-cli",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "repository": "davetorbeck/trello-cli",
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "^1.26.2",
    "@oclif/plugin-autocomplete": "^1.4.6",
    "@oclif/plugin-help": "^5.2.20",
    "@oclif/plugin-plugins": "^2.4.7",
    "@trello-cli/cache": "workspace:*",
    "@trello-cli/config": "workspace:*",
    "chrono-node": "^2.7.7",
    "json2csv": "^5.0.7",
    "trello.js": "^1.2.4"
  },
  "devDependencies": {
    "@types/json2csv": "^5.0.7",
    "@types/node": "^18.0.0",
    "oclif": "^3.17.2",
    "typescript": "^5.7.3"
  },
  "oclif": {
    "bin": "trello",
    "dirname": "trello-cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-autocomplete"
    ],
    "topicSeparator": ":",
    "topics": {}
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts $(find src/commands -name '*.ts') --outdir dist --target bun --splitting --root src",
    "dev": "bun build src/index.ts $(find src/commands -name '*.ts') --outdir dist --target bun --splitting --root src --watch",
    "lint": "eslint . --ext .ts --config .eslintrc",
    "prepack": "bun run build && oclif manifest && oclif readme",
    "test": "bun test",
    "version": "oclif readme && git add README.md"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": "https://github.com/davetorbeck/trello-cli/issues",
  "keywords": [
    "oclif"
  ],
  "types": "dist/index.d.ts"
}
